# Plantilla de variables de entorno.
#
# Copia este archivo como .env y rellena los valores:
#     cp .env.ejemplo .env
#
# El .env NO se versiona: cada quien mantiene el suyo. Si lo subes al
# repositorio, sus valores quedan publicos en el historial de GitHub.

# ── Base de datos ───────────────────────────────────────────────────────
# DB_HOST es el nombre del servicio en docker-compose, no un host externo.
DB_HOST=db
DB_USER=root
DB_PASSWORD=root
DB_NAME=donaciones

# ── Sesiones ────────────────────────────────────────────────────────────
# Firma los JWT de la aplicacion. Usa un valor largo y aleatorio, y uno
# distinto en cada entorno. Generar uno:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Al cambiarlo se cierran las sesiones abiertas: es lo esperado.
JWT_SECRET_KEY=

# ── Plataforma ──────────────────────────────────────────────────────────
# Organizacion principal con la que opera el sistema.
ID_ORGANIZACION_PRINCIPAL=1

# ── Inicio de sesion con Google (Firebase) ──────────────────────────────
# Todo este bloque es opcional: sin el, el boton de Google no se muestra y
# el ingreso con correo y contrasena sigue funcionando igual.
#
# Backend: la credencial de la cuenta de servicio NO va aqui. Guardala en
#   backend/secrets/firebase.json  (esa carpeta esta fuera de git)
# Se obtiene en: Firebase Console > Configuracion del proyecto >
#   Cuentas de servicio > Generar nueva clave privada
#
# Alternativa si prefieres variable en vez de archivo (el JSON en una linea):
# FIREBASE_CREDENTIALS_JSON=

# Frontend: datos publicos del proyecto; viajan en el bundle del navegador.
#   Firebase Console > Configuracion del proyecto > Tus apps > Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
